includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:

    paths:
        - app/

    # Level 10 is the highest level
    level: 7

    # Catatan: beberapa warning "unnecessary nullsafe (?->)" di bawah ini adalah
    # false positive dari larastan pada akses relasi Eloquent yang secara runtime
    # memang bisa null (relasi BelongsTo/HasMany pada record yang mungkin tidak
    # ada). Operator ?-> di sini disengaja demi keamanan null-pointer, sehingga
    # warning diabaikan per-baris (bukan per-kategori) agar warning sah lainnya
    # tetap muncul.
    ignoreErrors:
        # $user dari $request->user() pada route auth (non-null), tapi kolom
        # bobot_sumatif/bobot_sts nullable — ?-> dipertahankan untuk kejelasan.
        -
            message: '#Using nullsafe property access "\?->bobot_sumatif" on left side of \?\? is unnecessary#'
            path: app/Http/Controllers/RaporAdminController.php
        -
            message: '#Using nullsafe property access "\?->bobot_sts" on left side of \?\? is unnecessary#'
            path: app/Http/Controllers/RaporAdminController.php
        # Relasi nullable (guru.user, kelas, mataPelajaran, school/printSetting first())
        -
            message: '#Using nullsafe property access "\?->siswas" on left side of \?\? is unnecessary#'
            path: app/Http/Controllers/DashboardController.php
        -
            message: '#Using nullsafe property access "\?->nama_mapel" on left side of \?\? is unnecessary#'
            path: app/Http/Controllers/DashboardController.php
        -
            message: '#Using nullsafe property access "\?->nama" on left side of \?\? is unnecessary#'
            path: app/Http/Controllers/DashboardController.php
        -
            message: '#Using nullsafe property access "\?->city" on left side of \?\? is unnecessary#'
            path: app/Http/Controllers/RaporAdminController.php
        -
            message: '#Using nullsafe property access "\?->tempat_cetak" on left side of \?\? is unnecessary#'
            path: app/Http/Controllers/RaporAdminController.php
        -
            message: '#Using nullsafe property access "\?->tanggal_cetak" on left side of \?\? is unnecessary#'
            path: app/Http/Controllers/RaporAdminController.php
        -
            message: '#Using nullsafe property access "\?->sakit" on left side of \?\? is unnecessary#'
            path: app/Http/Controllers/RaporDataController.php
        -
            message: '#Using nullsafe property access "\?->izin" on left side of \?\? is unnecessary#'
            path: app/Http/Controllers/RaporDataController.php
        -
            message: '#Using nullsafe property access "\?->alpa" on left side of \?\? is unnecessary#'
            path: app/Http/Controllers/RaporDataController.php
        -
            message: '#Using nullsafe property access "\?->catatan_wali" on left side of \?\? is unnecessary#'
            path: app/Http/Controllers/RaporDataController.php
        -
            message: '#Using nullsafe property access "\?->city" on left side of \?\? is unnecessary#'
            path: app/Http/Controllers/RaportPrintController.php
        -
            message: '#Using nullsafe property access "\?->tempat_cetak" on left side of \?\? is unnecessary#'
            path: app/Http/Controllers/RaportPrintController.php
        -
            message: '#Using nullsafe property access "\?->tanggal_cetak_rapor" on left side of \?\? is unnecessary#'
            path: app/Http/Controllers/RaportPrintController.php
        # False positive struktural: shape return buildNilaiCollection sudah dinyatakan
        # lengkap dan identik dengan yang dilaporkan PHPStan, namun tetap ditandai.
        -
            message: '#Method App\\Http\\Controllers\\RaportPrintController::buildNilaiCollection\(\) should return#'
            path: app/Http/Controllers/RaportPrintController.php
